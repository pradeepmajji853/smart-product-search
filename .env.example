# Copy to .env and adjust. Never commit the real .env file.

# Main application database (used by the server, db:setup and db:seed)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/product_catalog

# Isolated database used ONLY by the automated server tests.
# The test suite truncates and re-populates this database, and refuses to run
# unless the database name contains "test" and differs from DATABASE_URL.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/product_catalog_test

# API server port (the Vite dev server proxies /api to this port)
PORT=4000

# Number of products generated by `npm run db:seed` (minimum 500)
SEED_COUNT=1000
