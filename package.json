{
  "name": "smart-product-search",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Product Search & Catalogue System (React + Express + PostgreSQL)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:setup": "node database/setup.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/setup.js --drop && node database/seed.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w client",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "db:explain": "node database/explain.js",
    "db:create": "node database/create.js",
    "verify:crosscheck": "node scripts/crosscheck.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
